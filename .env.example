# PDF READER CONFIGURATION# 
ENV=production
NODE_ENV=production production

# DATABASE
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme_production_password
DB_NAME=pdf_reader
DB_SSLMODE=disable


# REDIS CACHE

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
ENABLE_CACHE=true
CACHE_TTL=3600


# BACKEND
BACKEND_PORT=8080
MAX_FILE_SIZE=52428800
CORS_ORIGINS=http://localhost:3000,#
JWT_SECRET=


# STORAGE
STORAGE_TYPE=local
STORAGE_PATH=/app/storage

# S3 Storage 
# S3_ENDPOINT= S3_REGION=us-east-1
# S3_BUCKET=pdf-reader-storage
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# FRONTEND
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080


# SECURITY
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_WINDOW=3600

# File upload
ALLOWED_FILE_TYPES=application/pdf
MAX_UPLOAD_SIZE=50MB

# MONITORING 
# SENTRY_DSN=
LOG_LEVEL=info